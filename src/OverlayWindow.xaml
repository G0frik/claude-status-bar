<Window x:Class="ClaudeStatusBar.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Status Bar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="320"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- Glassy rounded pill. Fixed-width label and timer slots keep the layout stable as the
         label or timer changes. The whole pill opens the menu on either mouse button.
         The pill sizes to its content and is right-aligned, so it widens to the left when the
         session dots or usage bars show; the window is wide enough for all of them and never
         resizes. The unused strip is fully transparent and click-through. -->
    <Border x:Name="Root" HorizontalAlignment="Right"
            Padding="9,0,12,0" CornerRadius="7" ClipToBounds="True" Margin="0,3,0,3"
            Background="#59262626" BorderBrush="#22FFFFFF" BorderThickness="1"
            MouseRightButtonUp="OnMenuClick" MouseLeftButtonUp="OnOpenClick">
        <Border.ContextMenu>
            <ContextMenu x:Name="Menu">
                <MenuItem x:Name="MiTimer" Header="Show timer" IsCheckable="True" Click="OnToggleTimer"/>
                <MenuItem x:Name="MiUsage" Header="Show usage limits" IsCheckable="True" Click="OnToggleUsage"/>
                <!-- The online build inserts "Fetch usage online" and "Refresh usage every" here (OverlayWindow.AddOnlineUsageMenu). -->
                <MenuItem x:Name="MiSound" Header="Play Completion Sound"
                          IsCheckable="True" Click="OnToggleSound"/>
                <MenuItem Header="Notifications">
                    <MenuItem x:Name="MiNotify" Header="Show notifications" IsCheckable="True" Click="OnToggleNotify"/>
                    <Separator/>
                    <MenuItem x:Name="MiNotifyPermission" Header="When a session needs permission"
                              IsCheckable="True" Click="OnToggleNotifyPermission"/>
                    <MenuItem x:Name="MiNotifyFinished" Header="When a turn finishes"
                              IsCheckable="True" Click="OnToggleNotifyFinished"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Animation" IsEnabled="False"/>
                <MenuItem x:Name="MiStyleSpark" Header="Claude Spark" IsCheckable="True" Click="OnStyleSpark"/>
                <MenuItem x:Name="MiStyleCode"  Header="Claude Code"  IsCheckable="True" Click="OnStyleCode"/>
                <MenuItem x:Name="MiStyleCrab"  Header="Crab Walking" IsCheckable="True" Click="OnStyleCrab"/>
                <Separator/>
                <!-- Placeholder keeps the submenu expandable; items are rebuilt when it opens. -->
                <MenuItem x:Name="MiMonitors" Header="Show on" SubmenuOpened="OnMonitorsOpening">
                    <MenuItem Header="…" IsEnabled="False"/>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="MiVersion" Header="Version" IsEnabled="False"/>
                <MenuItem x:Name="MiQuit" Header="Quit Claude Status Bar" Click="OnQuit"/>
            </ContextMenu>
        </Border.ContextMenu>
        <!-- Columns: icon, label (wide enough for the longest verb), timer, session dots, usage
             bars. Fixed widths mean the layout is stable regardless of the current word or timer
             value. The dots and bars sit after the timer so they stay at the pill's right edge
             when the timer is empty. The dots (2+ sessions) and bars (usage data) collapse when
             unused. -->
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="135"/>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image x:Name="IconImg" Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center"
                   Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center" FontSize="12"
                       TextTrimming="CharacterEllipsis" TextAlignment="Left"
                       Foreground="#FFF0F0F0" Text="Claude"/>
            <!-- One dot per session when several run at once; built in code. Resting the mouse
                 here opens the sessions panel (SessionsPanel). As tall as the usage bars, so the
                 hover target is easy to hit. -->
            <StackPanel x:Name="SessionDots" Grid.Column="3" Orientation="Horizontal" Margin="6,0,0,0" Height="18"
                        VerticalAlignment="Center" Background="Transparent" Visibility="Collapsed"
                        Cursor="Hand"/>
            <!-- Usage limits: 5-hour window (left) and weekly window (right), filled bottom-up.
                 Fill heights, colors, and the tooltip are set in code. -->
            <StackPanel x:Name="UsageBars" Grid.Column="4" Orientation="Horizontal" Margin="6,0,0,0"
                        VerticalAlignment="Center" Background="Transparent" Visibility="Collapsed"
                        ToolTipService.Placement="Top" ToolTipService.VerticalOffset="-10"
                        ToolTipService.InitialShowDelay="300">
                <Border Width="4" Height="18" CornerRadius="2" Background="#33FFFFFF" Margin="0,0,3,0">
                    <Border x:Name="FiveHourFill" VerticalAlignment="Bottom" CornerRadius="2" Height="0"/>
                </Border>
                <Border Width="4" Height="18" CornerRadius="2" Background="#33FFFFFF">
                    <Border x:Name="SevenDayFill" VerticalAlignment="Bottom" CornerRadius="2" Height="0"/>
                </Border>
            </StackPanel>
            <TextBlock x:Name="TimerText" Grid.Column="2" VerticalAlignment="Center" FontSize="12"
                       FontFamily="Consolas" TextAlignment="Right"
                       Foreground="#FFC0C0C0" Text=""/>
        </Grid>
    </Border>
</Window>
